{
	"name": "clusterrighthand",
	"private": true,
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=24.7"
	},
	"scripts": {
		"build:crhs": "node scripts/build-crhs.ts",
		"package": "node scripts/package.ts",
		"package:oci": "node scripts/package.ts --oci",
		"check": "node scripts/check-module-cycles.ts && node scripts/check-web-layers.ts && biome check . && pnpm -r run typecheck && pnpm check:go",
		"check:go": "cd client && test -z \"$(gofmt -l .)\" && go vet ./...",
		"format": "biome check --write . && gofmt -w client",
		"test": "pnpm -r run test && pnpm test:go",
		"test:e2e": "pnpm --filter @crh/server test:e2e",
		"test:go": "cd client && GOTRACEBACK=all go test -timeout 300s ./...",
		"test:system": "pnpm --filter @crh/server test:system",
		"test:ui": "pnpm --filter @crh/web test:ui"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@types/node": "^26.6.5",
		"esbuild": "0.28.2",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"packageManager": "pnpm@12.15.0"
}
