{
	"name": "@crh/server",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=24.7"
	},
	"bin": {
		"crhs": "./src/main.ts"
	},
	"scripts": {
		"dev": "node --watch src/main.ts",
		"start": "node src/main.ts",
		"soak": "node test/soak/run.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --exclude 'test/e2e/**' --exclude 'test/perf/**' --exclude 'test/system/**' --exclude 'test/bundle/**' --exclude '**/node_modules/**'",
		"test:bundle": "vitest run test/bundle",
		"test:e2e": "vitest run test/e2e",
		"test:system": "vitest run test/system --no-file-parallelism",
		"test:perf": "NODE_OPTIONS=--expose-gc vitest run test/perf --no-file-parallelism"
	},
	"devDependencies": {
		"@modelcontextprotocol/client": "2.3.1",
		"@types/pg": "^8.23.1",
		"@types/ssh2": "^1.15.6",
		"@types/ws": "^8.18.2"
	},
	"dependencies": {
		"@crh/api": "workspace:*",
		"@crh/noise": "workspace:*",
		"@crh/protocol": "workspace:*",
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@hono/node-server": "^2.1.5",
		"@modelcontextprotocol/server": "2.3.1",
		"@simplewebauthn/server": "14.0.0",
		"age-encryption": "0.3.1",
		"capjs-core": "0.1.6",
		"croner": "^11.0.0",
		"hono": "^4.13.14",
		"kysely": "^0.29.7",
		"pg": "^8.23.1",
		"re2": "1.27.0",
		"smol-toml": "^1.9.1",
		"ssh2": "^1.17.0",
		"typebox": "1.3.27",
		"ws": "^8.22.0",
		"zod": "4.6.7"
	}
}
